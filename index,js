const SOURCE_SECRETS = {
  recibo: "RECIBO_URL",
  produccion: "PRODUCCION_URL",
  padrones: "PADRONES_URL",
  origenes: "ORIGENES_URL",
  pilas: "PILAS_URL",
};

function jsonError(message, status = 500) {
  return Response.json({ error: message }, {
    status,
    headers: { "Cache-Control": "no-store" },
  });
}

export default {
  async fetch(request, env) {
    const url = new URL(request.url);

    if (url.pathname.startsWith("/api/")) {
      if (request.method !== "GET") {
        return jsonError("Método no permitido.", 405);
      }

      const prefix = "/api/source/";
      if (!url.pathname.startsWith(prefix)) {
        return jsonError("Ruta API no encontrada.", 404);
      }

      const sourceKey = url.pathname.slice(prefix.length);
      const secretName = SOURCE_SECRETS[sourceKey];
      if (!secretName) {
        return jsonError("Fuente no reconocida.", 404);
      }

      const sourceUrl = env[secretName];
      if (!sourceUrl) {
        return jsonError(`Falta configurar el secreto ${secretName}.`, 503);
      }

      let upstream;
      try {
        upstream = await fetch(sourceUrl, {
          method: "GET",
          redirect: "follow",
          headers: { Accept: "*/*" },
        });
      } catch {
        return jsonError(`No se pudo consultar la fuente ${sourceKey}.`, 502);
      }

      if (!upstream.ok) {
        return jsonError(
          `Dropbox respondió HTTP ${upstream.status} para ${sourceKey}.`,
          502
        );
      }

      const headers = new Headers();
      headers.set(
        "Content-Type",
        upstream.headers.get("Content-Type") || "application/octet-stream"
      );
      headers.set("Cache-Control", "no-store, no-cache, must-revalidate");
      headers.set("X-Content-Type-Options", "nosniff");

      return new Response(upstream.body, { status: 200, headers });
    }

    return env.ASSETS.fetch(request);
  },
};
